generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String?   // null for social-only accounts
  displayName     String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  providers     UserProvider[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model UserProvider {
  id         String       @id @default(uuid())
  userId     String
  provider   AuthProvider
  providerId String       // Google sub, GitHub id, etc. — their ID in that provider's system
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId]) // one account per provider identity
  @@unique([userId, provider])     // one provider type per user
  @@index([userId])
  @@map("user_providers")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
